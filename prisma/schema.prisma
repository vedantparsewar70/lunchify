generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("PARENT") // "PARENT" | "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  parent       Parent?
}

model Parent {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletBalance Float     @default(500.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  students      Student[]
  orders        Order[]
}

model Student {
  id                  String           @id @default(cuid())
  parentId            String
  parent              Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name                String
  dob                 String?
  grade               String           // Class, e.g. "5"
  division            String           // Division, e.g. "A"
  rollNo              String
  studentId           String           @unique // e.g. "STU-2026-081"
  studentCategory     String?          // e.g. "Pre-primary", "Primary", "Secondary"
  allergies           String?          // e.g. "Peanuts, Dairy" (legacy string kept for quick display)
  dietaryRestrictions String?         // e.g. "No outside food", "Halal", "Gluten-free"
  foodPreference      String?          // e.g. "Vegetarian", "Jain", "Vegan"
  notes               String?          // e.g. "Requires allergy awareness."
  isVegetarian        Boolean          @default(true)
  profilePhoto        String?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  orderItems          OrderItem[]
  studentAllergies    StudentAllergy[]
}

model Allergy {
  id        String           @id @default(cuid())
  name      String           @unique // e.g. "Peanuts", "Milk", "Egg", "Soy", "Wheat", "Tree Nuts", "Other"
  createdAt DateTime         @default(now())
  students  StudentAllergy[]
}

model StudentAllergy {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allergyId  String
  allergy    Allergy  @relation(fields: [allergyId], references: [id], onDelete: Cascade)
  customNote String?  // For "Other: ______"
  createdAt  DateTime @default(now())

  @@unique([studentId, allergyId])
}

model Meal {
  id            String         @id @default(cuid())
  name          String
  description   String
  category      String         @default("LUNCH") // BREAKFAST, LUNCH, SNACK, BEVERAGE
  isVegetarian  Boolean        @default(true)
  ingredients   String?
  allergens     String?
  calories      Int?
  price         Float
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  menus         Menu[]
  orderItems    OrderItem[]
  mealAllergens MealAllergen[]
}

model Allergen {
  id        String         @id @default(cuid())
  name      String         @unique // e.g. "Milk", "Peanuts", "Egg", "Soy", "Wheat", "Tree Nuts"
  createdAt DateTime       @default(now())
  meals     MealAllergen[]
}

model MealAllergen {
  id         String   @id @default(cuid())
  mealId     String
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([mealId, allergenId])
}

model Menu {
  id               String   @id @default(cuid())
  mealId           String
  meal             Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  date             String   // "YYYY-MM-DD"
  studentCategory  String   @default("ALL") // "Pre-primary" | "Primary" | "Secondary" | "ALL"
  isHoliday        Boolean  @default(false)
  holidayReason    String?  // e.g. "Mahatma Gandhi Jayanti Holiday", "Dasara Holiday"
  availableQuantity Int     @default(50)
  maxQuantity      Int      @default(50)
  orderingDeadline String   @default("08:30") // Cutoff time "HH:mm" on that date or previous day
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([mealId, date, studentCategory])
}

model Order {
  id            String      @id // e.g. "ORD-2026-000123"
  parentId      String
  parent        Parent      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  totalAmount   Float
  paymentStatus String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  orderStatus   String      @default("CONFIRMED") // CONFIRMED, PREPARING, READY, COLLECTED, CANCELLED
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mealId            String
  meal              Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  date              String   // Meal date "YYYY-MM-DD"
  quantity          Int      @default(1)
  unitPrice         Float
  totalPrice        Float
  hasAllergyAlert   Boolean  @default(false)
  conflictAllergens String?  // e.g. "Milk"
  createdAt         DateTime @default(now())
}

model SystemSetting {
  key       String   @id // e.g. "ALLOW_ALLERGY_ORDERS"
  value     String   // e.g. "true" or "false"
  updatedAt DateTime @updatedAt
}

model Payment {
  id             String   @id // e.g. "PAY-2026-98124"
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float
  paymentMethod  String   // "UPI", "CARD", "NET_BANKING", "WALLET"
  status         String   @default("SUCCESS") // "SUCCESS", "PENDING", "FAILED"
  transactionRef String   // e.g. "TXN-UPI-98421049"
  upiId          String?
  cardLastFour   String?
  bankName       String?
  createdAt      DateTime @default(now())
}
