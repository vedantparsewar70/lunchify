# ==========================================
# SchoolBite Production Environment Configuration
# ==========================================

# 1. Application & Security
NODE_ENV=production
PORT=3000
JWT_SECRET=

# 2. Google Cloud Firebase / Firestore Configuration
# Credentials are read ONLY from environment variables. Never commit real values.
#
# Option A (recommended): individual environment variables
# FIREBASE_PRIVATE_KEY may be pasted with real line breaks, or on one line with
# literal \n sequences, e.g. "-----BEGIN PRIVATE KEY-----\n<key-body>\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Option B (alternative): full service-account JSON (raw or base64-encoded) in one variable.
# If set, it takes precedence over Option A. Leave unset when using Option A.
# FIREBASE_SERVICE_ACCOUNT_KEY=

# 3. Branding & Public Settings
NEXT_PUBLIC_APP_NAME=SchoolBite
NEXT_PUBLIC_SCHOOL_NAME="Greenwood High School"

# 4. Optional Admin / Staff Overrides
ADMIN_EMAIL=
STAFF_EMAIL=

# 5. Cashfree Payment Gateway Configuration
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01
NEXT_PUBLIC_CASHFREE_ENV=sandbox
